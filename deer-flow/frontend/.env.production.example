# Production environment variables for Vercel (or similar).
# Copy to .env.production.local for local production builds, or set in Vercel Dashboard.
#
# Required: Point to your GCP backend (API Gateway / Load Balancer URL).
NEXT_PUBLIC_BACKEND_BASE_URL=https://api.your-project.run.app
NEXT_PUBLIC_LANGGRAPH_BASE_URL=https://api.your-project.run.app

# Optional: If using better-auth in production
# BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32

# Skip env validation during CI/Docker build if URLs are set at deploy time
# SKIP_ENV_VALIDATION=1
